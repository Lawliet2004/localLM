{
  "name": "locallm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-web-worker.mjs && node --import ./scripts/register-test-loader.mjs scripts/build-genui-prompt.mjs && vite",
    "build": "node scripts/build-web-worker.mjs && node --import ./scripts/register-test-loader.mjs scripts/build-genui-prompt.mjs && tsc && vite build",
    "build:web": "node scripts/build-web-worker.mjs && node --import ./scripts/register-test-loader.mjs scripts/build-genui-prompt.mjs",
    "research": "node scripts/build-web-worker.mjs && node scripts/web-search-cli.mjs",
    "test:grounding": "node scripts/build-web-worker.mjs && node --test scripts/searxng-worker.test.mjs",
    "test:web-transport": "node --import ./scripts/register-test-loader.mjs --test scripts/web-transport.test.mjs scripts/web-render.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser-layout": "node scripts/test-browser-layout.mjs",
    "typecheck": "tsc --noEmit",
    "generate:openui": "node scripts/build-genui-prompt.mjs",
    "test:openui": "vitest run src/genui src/hooks/usePresentationMode.test.tsx src/components/GenUiBlock.test.tsx",
    "benchmark:openui": "node scripts/benchmark-openui.mjs",
    "test:genui-native": "node scripts/native-genui-acceptance.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.42.0",
    "mdast-util-from-markdown": "^2.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@openuidev/cli": "0.6.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "rehype-katex": {
      "katex": "$katex"
    },
    "micromark-extension-math": {
      "katex": "$katex"
    }
  }
}
