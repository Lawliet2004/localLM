{
  "version": 1,
  "defaultPreset": "standard",
  "presets": {
    "standard": {
      "name": "Standard",
      "description": "Full standard toolset and agent loop",
      "enabled": [
        "workspace_files",
        "local_execution",
        "cloud_execution",
        "system_time",
        "skills_reader",
        "session_log",
        "storage_sqlite",
        "agent_loop",
        "trajectory_ui",
        "git_tools",
        "lsp_tools"
      ],
      "disabled": []
    },
    "code_ptc": {
      "name": "Code",
      "description": "Coding capabilities with tools discovered as needed",
      "enabled": [
        "workspace_files",
        "local_execution",
        "system_time",
        "session_log",
        "storage_sqlite",
        "agent_loop",
        "trajectory_ui",
        "git_tools",
        "lsp_tools"
      ],
      "disabled": []
    },
    "minimal": {
      "name": "Minimal",
      "description": "Persistent shell and string replace editor for benchmarks",
      "enabled": [
        "local_execution",
        "workspace_files",
        "session_log",
        "storage_sqlite",
        "agent_loop"
      ],
      "disabled": [
        "cloud_execution",
        "system_time",
        "skills_reader"
      ]
    },
    "creator": {
      "name": "Creator",
      "description": "Standard mode with runtime inspector and plugin composition",
      "enabled": [
        "workspace_files",
        "local_execution",
        "cloud_execution",
        "system_time",
        "skills_reader",
        "session_log",
        "storage_sqlite",
        "agent_loop",
        "trajectory_ui",
        "git_tools",
        "lsp_tools"
      ],
      "disabled": []
    }
  },
  "capabilities": [
    {
      "id": "workspace_files",
      "kind": "Tool",
      "version": 1,
      "enabled": true,
      "description": "Workspace read/search/edit and recoverable file transactions (14 tools, cap-std).",
      "config": {}
    },
    {
      "id": "local_execution",
      "kind": "Tool",
      "version": 1,
      "enabled": true,
      "description": "Local Python/Node/PowerShell execution.",
      "config": {}
    },
    {
      "id": "git_tools",
      "kind": "Tool",
      "version": 1,
      "enabled": true,
      "description": "Typed Git status/diff/stage/commit/branch/history. Requires workspace and local execution; commits always ask.",
      "config": {}
    },
    {
      "id": "lsp_tools",
      "kind": "Tool",
      "version": 1,
      "enabled": true,
      "description": "Configured language servers for diagnostics, symbols, references and reviewed rename transactions. Requires workspace and local execution.",
      "config": {}
    },
    {
      "id": "cloud_execution",
      "kind": "Tool",
      "version": 1,
      "enabled": true,
      "description": "Daytona cloud execution.",
      "config": {}
    },
    {
      "id": "system_time",
      "kind": "Tool",
      "version": 1,
      "enabled": true,
      "description": "Local clock for the model; disable to hide it.",
      "config": {}
    },
    {
      "id": "skills_reader",
      "kind": "Tool",
      "version": 1,
      "enabled": true,
      "description": "Read installed skill files when skills are active.",
      "config": {}
    },
    {
      "id": "session_log",
      "kind": "Session",
      "version": 1,
      "enabled": true,
      "description": "Append-only session event log, lineage tracking, and replay.",
      "config": {}
    },
    {
      "id": "storage_sqlite",
      "kind": "Storage",
      "version": 1,
      "enabled": true,
      "description": "Local SQLite database persistence.",
      "config": {}
    },
    {
      "id": "agent_loop",
      "kind": "Loop",
      "version": 1,
      "enabled": true,
      "description": "Bounded agent iteration loop with approval gates.",
      "config": {}
    },
    {
      "id": "trajectory_ui",
      "kind": "Ui",
      "version": 1,
      "enabled": true,
      "description": "Interactive Trajectory event inspector and session branching UI.",
      "config": {}
    },
    {
      "id": "subagents",
      "kind": "Session",
      "version": 1,
      "enabled": false,
      "description": "Subagent spawning, forking, and background task execution.",
      "config": {
        "maxDepth": 3
      }
    },
    {
      "id": "mcp_resources_prompts",
      "kind": "Tool",
      "version": 1,
      "enabled": true,
      "description": "Bounded resources, URI templates and prompt retrieval from explicitly selected live MCP sources; retrieved content remains untrusted data.",
      "config": {
        "maxCatalogEntries": 512,
        "maxCatalogBytes": 2097152,
        "maxResultBytes": 262144
      }
    },
    {
      "id": "compaction",
      "kind": "Model",
      "version": 1,
      "enabled": true,
      "description": "Automatic context compaction at 80% plus manual checkpointing.",
      "config": {}
    }
  ]
}
