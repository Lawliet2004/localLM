+            json!({"command":"head -c 150000 /dev/zero | tr '\\000' 'x'", "timeout_secs":5})).await.unwrap();
+        let id = result["processId"].as_str().unwrap();
+        let retained = registry.retained_output("owner", root.path().to_str().unwrap(), id).unwrap();
+        let retained_bytes: usize = retained["output"].as_array().unwrap().iter().map(|f|f["text"].as_str().unwrap().len()).sum();
+        let returned_bytes = result["stdout"].as_str().unwrap().len();
+        eprintln!("AUDIT shell_run retained_bytes={retained_bytes}, returned_bytes={returned_bytes}, truncated={}, state={}", result["truncated"], result["status"]);
+        assert_eq!(retained_bytes, 150000);
+        assert!(returned_bytes < retained_bytes);
+        assert_eq!(result["truncated"], false);
+    }
