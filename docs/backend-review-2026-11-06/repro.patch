+mod audit_review_probes {
+    use super::*;
+    use serde_json::json;
+    fn event(c: &str, seq: u64, kind: &str, payload: serde_json::Value) -> crate::sessions::SessionEvent {
+        crate::sessions::SessionEvent { id:uuid::Uuid::new_v4().to_string(), conversation_id:c.into(), run_id:None,
+            seq, step_id:None, tool_call_id:None, event_type:kind.into(), payload, ignorable:false, created_at:seq as i64 }
+    }
+    #[test]
+    fn audit_review_fork_includes_messages_after_the_selected_event() {
+        let dir=tempfile::tempdir().unwrap(); let store=Store::open(&dir.path().join("test.sqlite")).unwrap();
+        let c=store.create_conversation().unwrap().id;
+        for (role,text) in [("user","original request"),("assistant","first answer"),("user","FUTURE request"),("assistant","FUTURE answer")] {
+            store.append_message(&c,role,text,"complete").unwrap();
+        }
+        for seq in 1..=7 { store.append_session_event(&event(&c,seq,if seq==6 {"user_msg"} else {"step_start"},json!({"marker":seq}))).unwrap(); }
+        let (fork,n)=store.fork_session_events(&c,4).unwrap(); let rows=store.messages(&fork.id).unwrap();
+        println!("AUDIT fork at event 4: copied_events={n}, copied_messages={:?}",rows.iter().map(|m|&m.content).collect::<Vec<_>>());
+        assert!(rows.iter().any(|m|m.content=="FUTURE request"),"probe expects the observed defect");
+    }
+    #[test]
+    fn audit_review_replay_and_fork_silently_stop_at_5000_events() {
+        let dir=tempfile::tempdir().unwrap(); let store=Store::open(&dir.path().join("test.sqlite")).unwrap();
+        let c=store.create_conversation().unwrap().id;
+        let tx=store.connection.unchecked_transaction().unwrap();
+        for seq in 1..=5005 { store.append_session_event(&event(&c,seq,"step_start",json!({"n":seq}))).unwrap(); }
+        tx.commit().unwrap();
+        let replay=store.session_events(&c,Some(0),Some(10000)).unwrap();
+        let (_fork,n)=store.fork_session_events(&c,5005).unwrap();
+        println!("AUDIT existing_events=5005, replay_events={}, fork_events={n}",replay.len());
+        assert_eq!(replay.len(),5000);assert_eq!(n,5000);
+    }
+    #[test]
+    fn audit_review_fork_retains_artifact_id_owned_by_original_conversation() {
+        let dir=tempfile::tempdir().unwrap(); let store=Store::open(&dir.path().join("test.sqlite")).unwrap();
+        let c=store.create_conversation().unwrap().id;
+        let artifact=crate::artifacts::ArtifactRecord{id:"art_review".into(),conversation_id:c.clone(),run_id:None,tool_name:"read_file".into(),mime_type:"text/plain".into(),size_bytes:4,sha256:"abcd".into(),content:"text".into(),created_at:1};
+        store.save_artifact(&artifact).unwrap();
+        store.append_session_event(&event(&c,1,"tool_result",json!({"result":{"_artifactId":artifact.id}}))).unwrap();
+        let (fork,_)=store.fork_session_events(&c,1).unwrap();
+        let events=store.session_events(&fork.id,Some(0),None).unwrap();let id=events[0].payload["result"]["_artifactId"].as_str().unwrap();
+        let saved=store.artifact(id).unwrap().unwrap();
+        println!("AUDIT fork artifact still owned by original={}, readable_under_fork={}",saved.conversation_id==c,saved.conversation_id==fork.id);
+        assert_ne!(saved.conversation_id,fork.id);
+    }
