+        let actual = std::fs::read_to_string(outside.path().join("file.txt")).unwrap();
+        eprintln!("AUDIT snapshot restore: outside file overwritten={}, failed_paths={}", actual == "captured workspace file", report.failed.len());
+        assert_eq!(actual, "captured workspace file");
