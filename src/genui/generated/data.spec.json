    "additionalProperties": false,
    "$defs": {
      "EvidenceView": {
        "type": "object",
        "properties": {
          "citationIds": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        },
        "required": [
          "citationIds"
        ],
        "additionalProperties": false,
        "description": "Actual host-collected evidence and claim audit. IDs must resolve; generated claims are never accepted as audit metadata."
      },
      "SeriesChart": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "series": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 240
                },
                "points": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "maxLength": 240
                      },
                      "value": {
                        "type": "number",
                        "minimum": -1000000000000,
                        "maximum": 1000000000000
                      }
                    },
                    "required": [
                      "label",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "name",
                "points"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "series"
        ],
        "additionalProperties": false,
        "description": "Compare supplied series locally; each series can be hidden. Values must be supplied together with their series and label."
      },
      "SourceChart": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "tableIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "kind": {
            "type": "string",
            "enum": [
              "bar",
              "line",
              "pie",
              "donut",
              "scatter"
            ]
          }
        },
        "required": [
          "id",
          "tableIndex",
          "kind"
        ],
        "additionalProperties": false,
        "description": "Chart exact host-bound values from a numeric two-column table in the authoritative answer; never transcribe or invent values."
      },
      "Chart": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "kind": {
            "type": "string",
            "enum": [
              "bar",
              "line",
              "pie",
              "donut",
              "scatter"
            ]
          },
          "points": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 240
                },
                "value": {
                  "type": "number",
                  "minimum": -1000000000000,
                  "maximum": 1000000000000
                },
                "x": {
