                },
                {
                  "$ref": "#/$defs/Callout"
                },
                {
                  "$ref": "#/$defs/Stat"
                },
                {
                  "$ref": "#/$defs/Table"
                },
                {
                  "$ref": "#/$defs/List"
                },
                {
                  "$ref": "#/$defs/KeyValue"
                },
                {
                  "$ref": "#/$defs/Progress"
                },
                {
                  "$ref": "#/$defs/Button"
                },
                {
                  "$ref": "#/$defs/Divider"
                }
              ]
            }
          }
        },
        "required": [
          "title",
          "children"
        ],
        "additionalProperties": false,
        "description": "A titled panel grouping related content."
      },
      "Columns": {
        "type": "object",
        "properties": {
          "children": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EvidenceView"
                },
                {
                  "$ref": "#/$defs/SeriesChart"
                },
                {
                  "$ref": "#/$defs/SourceChart"
                },
                {
                  "$ref": "#/$defs/Chart"
                },
                {
                  "$ref": "#/$defs/Diagram"
                },
                {
                  "$ref": "#/$defs/Timeline"
                },
                {
                  "$ref": "#/$defs/SourceCard"
                },
                {
                  "$ref": "#/$defs/Heading"
                },
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "$ref": "#/$defs/Markdown"
                },
                {
                  "$ref": "#/$defs/Callout"
