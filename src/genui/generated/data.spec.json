              "additionalProperties": false
            }
          },
          "edges": {
            "maxItems": 48,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 240
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "nodes",
          "edges"
        ],
        "additionalProperties": false,
        "description": "Directed concept/process graph."
      },
      "Timeline": {
        "type": "object",
        "properties": {
