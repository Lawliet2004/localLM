          "title",
          "kind",
          "points"
        ],
        "additionalProperties": false,
        "description": "Chart of supplied values; never invent data."
      },
      "Diagram": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "nodes": {
            "minItems": 1,
            "maxItems": 24,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 240
                },
                "detail": {
                  "type": "string",
                  "maxLength": 240
                }
              },
              "required": [
