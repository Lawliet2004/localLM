{
  "root": "Response",
  "components": {
    "EvidenceView": {
      "signature": "EvidenceView(citationIds: string[])",
      "description": "Actual host-collected evidence and claim audit. IDs must resolve; generated claims are never accepted as audit metadata."
    },
    "SeriesChart": {
      "signature": "SeriesChart(title: string, series: {name: string, points: {label: string, value: number}[]}[])",
      "description": "Compare supplied series locally; each series can be hidden. Values must be supplied together with their series and label."
    },
    "SourceChart": {
      "signature": "SourceChart(id: string, tableIndex: number, kind: \"bar\" | \"line\" | \"pie\" | \"donut\" | \"scatter\")",
      "description": "Chart exact host-bound values from a numeric two-column table in the authoritative answer; never transcribe or invent values."
    },
    "Chart": {
      "signature": "Chart(title: string, kind: \"bar\" | \"line\" | \"pie\" | \"donut\" | \"scatter\", points: {label: string, value: number, x?: number}[], xLabel?: string, yLabel?: string)",
      "description": "Chart of supplied values; never invent data."
    },
    "Diagram": {
      "signature": "Diagram(title: string, nodes: {id: string, label: string, detail?: string}[], edges: {from: string, to: string, label?: string}[])",
      "description": "Directed concept/process graph."
    },
    "Timeline": {
      "signature": "Timeline(title: string, events: {date: string, title: string, detail?: string}[])",
      "description": "Ordered dated events."
    },
    "SourceCard": {
      "signature": "SourceCard(citationId: string, title: string, summary?: string)",
      "description": "Reference an actual evidence ID from the answer. Never invent IDs."
    },
    "Heading": {
      "signature": "Heading(text: string, level?: \"h2\" | \"h3\" | \"h4\")",
      "description": "A section heading."
    },
    "Text": {
      "signature": "Text(text: string)",
      "description": "Plain text, no Markdown."
    },
    "Markdown": {
      "signature": "Markdown(text: string)",
      "description": "A block of Markdown text. Use for prose, explanations and formatted text inside the UI."
    },
    "Callout": {
      "signature": "Callout(text: string, tone?: \"info\" | \"success\" | \"warning\" | \"error\")",
      "description": "A highlighted note for a warning, tip, success or error the user should notice."
    },
    "Stat": {
      "signature": "Stat(label: string, value: string, detail?: string)",
      "description": "A single metric with a label and an optional detail line."
    },
    "Table": {
      "signature": "Table(columns: string[], rows: (string | number)[][], id?: string)",
      "description": "A simple data table. Use instead of a Markdown table when the data is the focus."
    },
    "List": {
      "signature": "List(items: string[])",
      "description": "A short bulleted list of plain-text items."
    },
    "KeyValue": {
      "signature": "KeyValue(entries: {label: string, value: string}[])",
      "description": "Label/value pairs such as settings, status fields or metadata."
    },
    "Progress": {
      "signature": "Progress(label: string, percent: number, detail?: string)",
      "description": "A progress bar for completion, usage or quota values."
    },
    "Button": {
      "signature": "Button(label: string, action?: {type: \"continue_conversation\", message?: string} | {type: \"open_url\", url: string}, variant?: \"primary\" | \"secondary\")",
      "description": "A clickable button for suggested follow-ups or opening a link. Place one or a small row at the end of a UI block."
    },
    "Divider": {
      "signature": "Divider()",
      "description": "A thin horizontal rule separating sections."
    },
    "Section": {
      "signature": "Section(title: string, children: (EvidenceView | SeriesChart | SourceChart | Chart | Diagram | Timeline | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | KeyValue | Progress | Button | Divider)[])",
      "description": "A titled panel grouping related content."
    },
    "Columns": {
      "signature": "Columns(children: (EvidenceView | SeriesChart | SourceChart | Chart | Diagram | Timeline | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | KeyValue | Progress | Button | Divider)[])",
      "description": "Places children side by side, wrapping on narrow widths. Ideal for a row of Stat cards."
    },
    "Card": {
      "signature": "Card(title: string, children: (EvidenceView | SeriesChart | SourceChart | Chart | Diagram | Timeline | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | KeyValue | Progress | Button | Divider)[])",
      "description": "A titled group of related content."
    },
    "Stack": {
      "signature": "Stack(children: (EvidenceView | SeriesChart | SourceChart | Chart | Diagram | Timeline | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | KeyValue | Progress | Button | Divider | Card)[])",
      "description": "Content arranged vertically."
    },
    "Row": {
      "signature": "Row(children: (EvidenceView | SeriesChart | SourceChart | Chart | Diagram | Timeline | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | KeyValue | Progress | Button | Divider | Card)[])",
      "description": "Content in a wrapping horizontal row."
    },
    "Grid": {
      "signature": "Grid(children: (EvidenceView | SeriesChart | SourceChart | Chart | Diagram | Timeline | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | KeyValue | Progress | Button | Divider | Card)[], columns?: number)",
      "description": "Responsive equal-width content columns."
    },
    "Response": {
      "signature": "Response(children: (EvidenceView | SeriesChart | SourceChart | Chart | Diagram | Timeline | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | KeyValue | Progress | Button | Divider | Section | Columns | Card | Stack | Row | Grid)[])",
      "description": "Root container of every UI block. Assign it to `root` and pass content as children."
    }
  },
  "componentGroups": [
    {
      "name": "Visual data",
      "components": [
        "Chart",
        "SourceChart",
        "SeriesChart",
        "Diagram",
        "Timeline",
        "SourceCard",
        "EvidenceView"
      ]
    },
    {
      "name": "Content",
      "components": [
        "Heading",
        "Text",
        "Markdown",
        "Callout"
      ]
    },
    {
      "name": "Data",
      "components": [
        "Stat",
        "Table",
        "List",
        "KeyValue",
        "Progress"
      ]
    },
    {
      "name": "Actions",
      "components": [
        "Button"
      ]
    },
    {
      "name": "Layout",
      "components": [
        "Divider",
        "Section",
        "Columns",
        "Card",
        "Stack",
        "Row",
        "Grid",
        "Response"
      ]
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
