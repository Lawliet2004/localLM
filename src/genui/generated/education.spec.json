{
  "root": "Response",
  "components": {
    "FunctionPlot": {
      "signature": "FunctionPlot(title: string, parameterId: string, family: \"linear\" | \"quadratic\" | \"exponential\", minX: number, maxX: number)",
      "description": "Educational finite function plot driven by a Slider with the same parameterId. No expressions or code."
    },
    "EvidenceView": {
      "signature": "EvidenceView(citationIds: string[])",
      "description": "Actual host-collected evidence and claim audit. IDs must resolve; generated claims are never accepted as audit metadata."
    },
    "Calculator": {
      "signature": "Calculator(id: string, title: string, operation: \"add\" | \"multiply\" | \"divide\" | \"power\", a: number, b: number)",
      "description": "Local bounded arithmetic; never executes code."
    },
    "Diagram": {
      "signature": "Diagram(title: string, nodes: {id: string, label: string, detail?: string}[], edges: {from: string, to: string, label?: string}[])",
      "description": "Directed concept/process graph."
    },
    "Timeline": {
      "signature": "Timeline(title: string, events: {date: string, title: string, detail?: string}[])",
      "description": "Ordered dated events."
    },
    "Quiz": {
      "signature": "Quiz(id: string, title: string, questions: {question: string, options: string[], answer: number, explanation: string}[])",
      "description": "Local scored multiple-choice quiz."
    },
    "Flashcard": {
      "signature": "Flashcard(id: string, front: string, back: string)",
      "description": "Flip to reveal an answer."
    },
    "InteractiveExample": {
      "signature": "InteractiveExample(id: string, kind: \"sorting\" | \"binary-search\" | \"lru\" | \"bfs\" | \"dfs\" | \"sql-join\" | \"gradient-descent\", values: number[], target?: number, capacity?: number, edges?: any[])",
      "description": "Deterministic educational simulation, not execution."
    },
    "Slider": {
      "signature": "Slider(id: string, label: string, min: number, max: number, value: number, step?: number)",
      "description": "Local numeric control."
    },
    "Toggle": {
      "signature": "Toggle(id: string, label: string, value: boolean)",
      "description": "Local on/off control."
    },
    "Select": {
      "signature": "Select(id: string, label: string, options: string[], value: string)",
      "description": "Local choice control."
    },
    "Input": {
      "signature": "Input(id: string, label: string, value: string)",
      "description": "Local text field. Never sends hidden requests."
    },
    "SourceCard": {
      "signature": "SourceCard(citationId: string, title: string, summary?: string)",
      "description": "Reference an actual evidence ID from the answer. Never invent IDs."
    },
    "Heading": {
      "signature": "Heading(text: string, level?: \"h2\" | \"h3\" | \"h4\")",
      "description": "A section heading."
    },
    "Text": {
      "signature": "Text(text: string)",
      "description": "Plain text, no Markdown."
    },
    "Markdown": {
      "signature": "Markdown(text: string)",
      "description": "A block of Markdown text. Use for prose, explanations and formatted text inside the UI."
    },
    "Callout": {
      "signature": "Callout(text: string, tone?: \"info\" | \"success\" | \"warning\" | \"error\")",
      "description": "A highlighted note for a warning, tip, success or error the user should notice."
    },
    "Stat": {
      "signature": "Stat(label: string, value: string, detail?: string)",
      "description": "A single metric with a label and an optional detail line."
    },
    "Table": {
      "signature": "Table(columns: string[], rows: (string | number)[][], id?: string)",
      "description": "A simple data table. Use instead of a Markdown table when the data is the focus."
    },
    "List": {
      "signature": "List(items: string[])",
      "description": "A short bulleted list of plain-text items."
    },
    "Button": {
      "signature": "Button(label: string, action?: {type: \"continue_conversation\", message?: string} | {type: \"open_url\", url: string}, variant?: \"primary\" | \"secondary\")",
      "description": "A clickable button for suggested follow-ups or opening a link. Place one or a small row at the end of a UI block."
    },
    "Divider": {
      "signature": "Divider()",
      "description": "A thin horizontal rule separating sections."
    },
    "Section": {
      "signature": "Section(title: string, children: (FunctionPlot | EvidenceView | Calculator | Diagram | Timeline | Quiz | Flashcard | InteractiveExample | Slider | Toggle | Select | Input | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | Button | Divider)[])",
      "description": "A titled panel grouping related content."
    },
    "Columns": {
      "signature": "Columns(children: (FunctionPlot | EvidenceView | Calculator | Diagram | Timeline | Quiz | Flashcard | InteractiveExample | Slider | Toggle | Select | Input | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | Button | Divider)[])",
      "description": "Places children side by side, wrapping on narrow widths. Ideal for a row of Stat cards."
    },
    "Card": {
      "signature": "Card(title: string, children: (FunctionPlot | EvidenceView | Calculator | Diagram | Timeline | Quiz | Flashcard | InteractiveExample | Slider | Toggle | Select | Input | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | Button | Divider)[])",
      "description": "A titled group of related content."
    },
    "Stack": {
      "signature": "Stack(children: (FunctionPlot | EvidenceView | Calculator | Diagram | Timeline | Quiz | Flashcard | InteractiveExample | Slider | Toggle | Select | Input | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | Button | Divider | Card)[])",
      "description": "Content arranged vertically."
    },
    "Row": {
      "signature": "Row(children: (FunctionPlot | EvidenceView | Calculator | Diagram | Timeline | Quiz | Flashcard | InteractiveExample | Slider | Toggle | Select | Input | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | Button | Divider | Card)[])",
      "description": "Content in a wrapping horizontal row."
    },
    "Grid": {
      "signature": "Grid(children: (FunctionPlot | EvidenceView | Calculator | Diagram | Timeline | Quiz | Flashcard | InteractiveExample | Slider | Toggle | Select | Input | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | Button | Divider | Card)[], columns?: number)",
      "description": "Responsive equal-width content columns."
    },
    "Response": {
      "signature": "Response(children: (FunctionPlot | EvidenceView | Calculator | Diagram | Timeline | Quiz | Flashcard | InteractiveExample | Slider | Toggle | Select | Input | SourceCard | Heading | Text | Markdown | Callout | Stat | Table | List | Button | Divider | Section | Columns | Card | Stack | Row | Grid)[])",
      "description": "Root container of every UI block. Assign it to `root` and pass content as children."
    }
  },
  "componentGroups": [
    {
      "name": "Visual data",
      "components": [
        "Diagram",
        "Timeline",
        "SourceCard",
        "EvidenceView"
      ]
    },
    {
