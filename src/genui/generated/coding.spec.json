{
  "root": "Response",
  "components": {
    "EvidenceView": {
      "signature": "EvidenceView(citationIds: string[])",
      "description": "Actual host-collected evidence and claim audit. IDs must resolve; generated claims are never accepted as audit metadata."
    },
    "SourceCode": {
      "signature": "SourceCode(fenceIndex: number, path?: string)",
      "description": "Read-only exact code from a closed fence in the authoritative answer. Never transcribe, edit or execute it."
    },
    "Diagram": {
      "signature": "Diagram(title: string, nodes: {id: string, label: string, detail?: string}[], edges: {from: string, to: string, label?: string}[])",
      "description": "Directed concept/process graph."
    },
    "Timeline": {
      "signature": "Timeline(title: string, events: {date: string, title: string, detail?: string}[])",
      "description": "Ordered dated events."
    },
    "FilePreview": {
      "signature": "FilePreview(path: string, code: string, language?: string)",
      "description": "Literal code sample with display-only path."
    },
    "FileTree": {
      "signature": "FileTree(paths: string[], id?: string)",
      "description": "Display-only file list; no filesystem access."
    },
    "DiffViewer": {
      "signature": "DiffViewer(diff: string, id?: string)",
      "description": "Literal unified diff."
    },
    "SourceCard": {
      "signature": "SourceCard(citationId: string, title: string, summary?: string)",
      "description": "Reference an actual evidence ID from the answer. Never invent IDs."
    },
    "Heading": {
      "signature": "Heading(text: string, level?: \"h2\" | \"h3\" | \"h4\")",
      "description": "A section heading."
    },
    "Text": {
      "signature": "Text(text: string)",
      "description": "Plain text, no Markdown."
    },
    "Markdown": {
      "signature": "Markdown(text: string)",
      "description": "A block of Markdown text. Use for prose, explanations and formatted text inside the UI."
    },
    "Callout": {
      "signature": "Callout(text: string, tone?: \"info\" | \"success\" | \"warning\" | \"error\")",
      "description": "A highlighted note for a warning, tip, success or error the user should notice."
    },
    "CodeBlock": {
      "signature": "CodeBlock(code: string, language?: string)",
      "description": "A labeled block of source code or terminal output."
    },
    "Table": {
      "signature": "Table(columns: string[], rows: (string | number)[][], id?: string)",
      "description": "A simple data table. Use instead of a Markdown table when the data is the focus."
    },
    "List": {
      "signature": "List(items: string[])",
      "description": "A short bulleted list of plain-text items."
    },
    "Button": {
      "signature": "Button(label: string, action?: {type: \"continue_conversation\", message?: string} | {type: \"open_url\", url: string}, variant?: \"primary\" | \"secondary\")",
      "description": "A clickable button for suggested follow-ups or opening a link. Place one or a small row at the end of a UI block."
    },
    "Divider": {
      "signature": "Divider()",
      "description": "A thin horizontal rule separating sections."
    },
    "Section": {
      "signature": "Section(title: string, children: (EvidenceView | SourceCode | Diagram | Timeline | FilePreview | FileTree | DiffViewer | SourceCard | Heading | Text | Markdown | Callout | CodeBlock | Table | List | Button | Divider)[])",
      "description": "A titled panel grouping related content."
    },
    "Columns": {
      "signature": "Columns(children: (EvidenceView | SourceCode | Diagram | Timeline | FilePreview | FileTree | DiffViewer | SourceCard | Heading | Text | Markdown | Callout | CodeBlock | Table | List | Button | Divider)[])",
      "description": "Places children side by side, wrapping on narrow widths. Ideal for a row of Stat cards."
    },
    "Card": {
      "signature": "Card(title: string, children: (EvidenceView | SourceCode | Diagram | Timeline | FilePreview | FileTree | DiffViewer | SourceCard | Heading | Text | Markdown | Callout | CodeBlock | Table | List | Button | Divider)[])",
      "description": "A titled group of related content."
    },
    "Stack": {
      "signature": "Stack(children: (EvidenceView | SourceCode | Diagram | Timeline | FilePreview | FileTree | DiffViewer | SourceCard | Heading | Text | Markdown | Callout | CodeBlock | Table | List | Button | Divider | Card)[])",
      "description": "Content arranged vertically."
    },
    "Row": {
      "signature": "Row(children: (EvidenceView | SourceCode | Diagram | Timeline | FilePreview | FileTree | DiffViewer | SourceCard | Heading | Text | Markdown | Callout | CodeBlock | Table | List | Button | Divider | Card)[])",
      "description": "Content in a wrapping horizontal row."
    },
    "Grid": {
      "signature": "Grid(children: (EvidenceView | SourceCode | Diagram | Timeline | FilePreview | FileTree | DiffViewer | SourceCard | Heading | Text | Markdown | Callout | CodeBlock | Table | List | Button | Divider | Card)[], columns?: number)",
      "description": "Responsive equal-width content columns."
    },
    "Response": {
      "signature": "Response(children: (EvidenceView | SourceCode | Diagram | Timeline | FilePreview | FileTree | DiffViewer | SourceCard | Heading | Text | Markdown | Callout | CodeBlock | Table | List | Button | Divider | Section | Columns | Card | Stack | Row | Grid)[])",
      "description": "Root container of every UI block. Assign it to `root` and pass content as children."
    }
  },
  "componentGroups": [
    {
      "name": "Visual data",
      "components": [
        "Diagram",
        "Timeline",
        "SourceCard",
        "EvidenceView"
      ]
    },
    {
      "name": "Coding",
      "components": [
        "FilePreview",
        "SourceCode",
        "FileTree",
        "DiffViewer"
      ]
    },
    {
      "name": "Content",
      "components": [
        "Heading",
        "Text",
        "Markdown",
        "Callout",
        "CodeBlock"
      ]
    },
    {
      "name": "Data",
      "components": [
        "Table",
        "List"
      ]
    },
    {
      "name": "Actions",
      "components": [
        "Button"
      ]
    },
    {
      "name": "Layout",
      "components": [
        "Divider",
        "Section",
        "Columns",
        "Card",
        "Stack",
        "Row",
        "Grid",
        "Response"
      ]
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "EvidenceView": {
        "$ref": "#/$defs/EvidenceView"
      },
      "SourceCode": {
        "$ref": "#/$defs/SourceCode"
