    "additionalProperties": false,
    "$defs": {
      "EvidenceView": {
        "type": "object",
        "properties": {
          "citationIds": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        },
        "required": [
          "citationIds"
        ],
        "additionalProperties": false,
        "description": "Actual host-collected evidence and claim audit. IDs must resolve; generated claims are never accepted as audit metadata."
      },
      "SourceCode": {
        "type": "object",
        "properties": {
          "fenceIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "path": {
            "type": "string",
            "maxLength": 240
          }
        },
        "required": [
          "fenceIndex"
        ],
        "additionalProperties": false,
        "description": "Read-only exact code from a closed fence in the authoritative answer. Never transcribe, edit or execute it."
      },
      "Diagram": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "nodes": {
            "minItems": 1,
            "maxItems": 24,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 240
                },
                "detail": {
                  "type": "string",
                  "maxLength": 240
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "edges": {
            "maxItems": 48,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 240
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "nodes",
          "edges"
        ],
        "additionalProperties": false,
        "description": "Directed concept/process graph."
      },
      "Timeline": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "events": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "maxLength": 240
                },
                "title": {
                  "type": "string",
                  "maxLength": 240
                },
                "detail": {
                  "type": "string",
                  "maxLength": 240
                }
              },
              "required": [
                "date",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "events"
        ],
        "additionalProperties": false,
        "description": "Ordered dated events."
      },
      "FilePreview": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240
          },
          "code": {
            "type": "string",
            "maxLength": 16384
          },
          "language": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "path",
          "code"
        ],
        "additionalProperties": false,
        "description": "Literal code sample with display-only path."
      },
      "FileTree": {
        "type": "object",
        "properties": {
          "paths": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 240
            }
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          }
        },
        "required": [
          "paths"
        ],
        "additionalProperties": false,
        "description": "Display-only file list; no filesystem access."
      },
      "DiffViewer": {
        "type": "object",
        "properties": {
          "diff": {
            "type": "string",
            "maxLength": 16384
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          }
        },
        "required": [
          "diff"
        ],
        "additionalProperties": false,
        "description": "Literal unified diff."
      },
      "SourceCard": {
        "type": "object",
        "properties": {
          "citationId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "summary": {
            "type": "string",
            "maxLength": 240
          }
        },
        "required": [
          "citationId",
          "title"
        ],
        "additionalProperties": false,
        "description": "Reference an actual evidence ID from the answer. Never invent IDs."
      },
      "Heading": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 240
          },
          "level": {
            "type": "string",
            "enum": [
              "h2",
              "h3",
              "h4"
            ]
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "description": "A section heading."
      },
      "Text": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "description": "Plain text, no Markdown."
      },
      "Markdown": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "description": "A block of Markdown text. Use for prose, explanations and formatted text inside the UI."
      },
      "Callout": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 16384
          },
          "tone": {
            "type": "string",
            "enum": [
              "info",
              "success",
              "warning",
              "error"
            ]
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "description": "A highlighted note for a warning, tip, success or error the user should notice."
      },
      "CodeBlock": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 16384
