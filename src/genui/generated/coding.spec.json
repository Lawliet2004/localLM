                },
                {
                  "$ref": "#/$defs/Table"
                },
                {
                  "$ref": "#/$defs/List"
                },
                {
                  "$ref": "#/$defs/Button"
                },
                {
                  "$ref": "#/$defs/Divider"
                }
              ]
            }
          }
        },
        "required": [
          "children"
        ],
        "additionalProperties": false,
        "description": "Places children side by side, wrapping on narrow widths. Ideal for a row of Stat cards."
      },
      "Card": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "children": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EvidenceView"
                },
                {
                  "$ref": "#/$defs/SourceCode"
                },
                {
                  "$ref": "#/$defs/Diagram"
                },
                {
                  "$ref": "#/$defs/Timeline"
                },
                {
                  "$ref": "#/$defs/FilePreview"
                },
                {
                  "$ref": "#/$defs/FileTree"
                },
                {
                  "$ref": "#/$defs/DiffViewer"
                },
                {
                  "$ref": "#/$defs/SourceCard"
                },
                {
                  "$ref": "#/$defs/Heading"
                },
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "$ref": "#/$defs/Markdown"
                },
                {
                  "$ref": "#/$defs/Callout"
                },
                {
                  "$ref": "#/$defs/CodeBlock"
                },
                {
                  "$ref": "#/$defs/Table"
                },
                {
                  "$ref": "#/$defs/List"
                },
                {
                  "$ref": "#/$defs/Button"
                },
                {
                  "$ref": "#/$defs/Divider"
