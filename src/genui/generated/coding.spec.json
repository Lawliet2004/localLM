      },
      "Stack": {
        "type": "object",
        "properties": {
          "children": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/EvidenceView"
                    },
                    {
                      "$ref": "#/$defs/SourceCode"
                    },
                    {
                      "$ref": "#/$defs/Diagram"
                    },
                    {
                      "$ref": "#/$defs/Timeline"
                    },
                    {
                      "$ref": "#/$defs/FilePreview"
                    },
                    {
                      "$ref": "#/$defs/FileTree"
                    },
                    {
                      "$ref": "#/$defs/DiffViewer"
                    },
                    {
                      "$ref": "#/$defs/SourceCard"
                    },
                    {
                      "$ref": "#/$defs/Heading"
                    },
                    {
                      "$ref": "#/$defs/Text"
