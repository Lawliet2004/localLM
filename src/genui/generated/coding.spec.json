            "maxLength": 40
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "description": "A labeled block of source code or terminal output."
      },
      "Table": {
        "type": "object",
        "properties": {
          "columns": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 240
            }
          },
          "rows": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "maxItems": 12,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 240
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          },
          "id": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "columns",
          "rows"
        ],
        "additionalProperties": false,
        "description": "A simple data table. Use instead of a Markdown table when the data is the focus."
      },
      "List": {
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 16384
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false,
        "description": "A short bulleted list of plain-text items."
      },
      "Button": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "action": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "continue_conversation"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "open_url"
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "additionalProperties": false
              }
            ]
          },
          "variant": {
            "type": "string",
            "enum": [
              "primary",
              "secondary"
            ]
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false,
        "description": "A clickable button for suggested follow-ups or opening a link. Place one or a small row at the end of a UI block."
      },
      "Divider": {
        "type": "object",
        "properties": {},
