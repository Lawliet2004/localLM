                  "$ref": "#/$defs/Button"
                },
                {
                  "$ref": "#/$defs/Divider"
                }
              ]
            }
          }
        },
        "required": [
          "title",
          "children"
        ],
        "additionalProperties": false,
        "description": "A titled panel grouping related content."
